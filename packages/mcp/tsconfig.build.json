{
  "// owns": "Emitting project of @jsnb/mcp: src without tests and fixtures into dist, in dependency order under tsc -b.",
  "extends": "../../tsconfig.node.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/fixtures/**"],
  "references": [
    {
      "path": "../client/tsconfig.build.json"
    },
    {
      "path": "../core/tsconfig.build.json"
    }
  ]
}
