{
  "name": "@jsnb/tokens",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "src/*.css"
  ],
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./page.css": "./src/page.css",
    "./viewer.css": "./src/viewer.css"
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "generate": "node --conditions=development --import ./scripts/resolve-ts.mjs ./scripts/generate.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3"
  }
}
